# Copy to .env (loaded by Taskfile). Values match docker-compose.yml.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Application role: RLS enforced.
DATABASE_URL=postgres://teatchable_app:teatchable_app@localhost:55432/teatchable?sslmode=disable
# Schema owner: migrations only.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:55432/teatchable?sslmode=disable

# Hosts. Browsers resolve *.localhost to 127.0.0.1, so demo.localhost:3000 works without /etc/hosts.
ROOT_DOMAIN=localhost
APP_HOST=app.localhost
ADMIN_HOST=admin.localhost

TRUST_PROXY=true
COOKIE_SECURE=false
SESSION_TTL=720h
